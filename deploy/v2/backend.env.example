APP_ENV=production
APP_SECRET_KEY=replace-with-at-least-32-random-characters
DATABASE_URL=postgresql+psycopg://postgres:replace-password@replace-host.neon.tech/immo3d?sslmode=require
FRONTEND_ORIGIN=https://www.example.com
FRONTEND_ORIGINS=https://www.example.com
SESSION_COOKIE_NAME=immo3d_session
SESSION_MAX_AGE_SECONDS=604800
COOKIE_SECURE=true
COOKIE_SAMESITE=lax
CSRF_HEADER_NAME=X-CSRF-Token
ALLOWED_HOSTS=www.example.com,example.com
BILLING_REQUIRED=false
DATA_ENCRYPTION_KEY=replace-with-second-random-key-32-chars-min
BACKUP_DIR=/var/lib/immo3d/backups
BACKUP_RETENTION_COUNT=14
BACKUP_INTERVAL_MINUTES=60
BACKUP_VERIFY_AFTER_CREATE=true
BACKUP_ENCRYPTION_KEY=replace-with-third-random-key-32-chars-min
PHOTO_UPLOAD_MAX_BYTES=8388608

# Canonical public domains
APP_DOMAIN=www.example.com
ROOT_DOMAIN=example.com
TLS_EMAIL=ops@example.com
APP_HEALTHCHECK_URL=https://www.example.com/health

# Optional Stripe (when BILLING_REQUIRED=true)
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
STRIPE_API_VERSION=
BILLING_BYPASS_IDENTITIES=

# Reserved for V2 object storage (Cloudflare R2)
R2_ACCOUNT_ID=
R2_BUCKET=
R2_REGION=auto
R2_ENDPOINT_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BASE_URL=
R2_UPLOAD_URL_TTL_SECONDS=300
R2_OBJECT_KEY_PREFIX=uploads
