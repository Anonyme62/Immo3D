APP_ENV=production
APP_SECRET_KEY=replace-with-a-random-secret-of-at-least-32-characters
DATABASE_URL=sqlite:///./immo3d.db
FRONTEND_ORIGIN=https://www.example.com
FRONTEND_ORIGINS=https://www.example.com
SESSION_COOKIE_NAME=immo3d_session
SESSION_MAX_AGE_SECONDS=604800
COOKIE_SECURE=true
COOKIE_SAMESITE=lax
CSRF_HEADER_NAME=X-CSRF-Token
ALLOWED_HOSTS=www.example.com,example.com
BILLING_REQUIRED=true
DATA_ENCRYPTION_KEY=replace-with-a-second-random-secret-of-at-least-32-characters
STRIPE_SECRET_KEY=sk_live_xxx
STRIPE_PRICE_ID=price_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_API_VERSION=
BACKUP_DIR=backups
BACKUP_RETENTION_COUNT=14
BACKUP_INTERVAL_MINUTES=0
BACKUP_VERIFY_AFTER_CREATE=true
BACKUP_ENCRYPTION_KEY=replace-with-a-third-random-secret-of-at-least-32-characters
